# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/org_ai

# AI Provider Configuration
# Supported providers: openai, gemini, ollama, mock
AI_PROVIDER=openai
AI_API_KEY=your_llm_api_key_here
AI_MODEL=gpt-4o-mini
# Optional custom base URL for Ollama, OpenRouter, Azure, or Gemini OpenAI compatibility:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Embedding Provider Configuration
# Supported providers: openai, gemini, ollama, mock
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Optional custom base URL:
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local File Storage Path (relative to backend or absolute path)
STORAGE_PATH=../../storage/documents

# Multi-tenancy / Organization Configuration
DEMO_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
DEMO_ORGANIZATION_NAME=Demo Organization

# Document Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=5
SIMILARITY_THRESHOLD=0.3

